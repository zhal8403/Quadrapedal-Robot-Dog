#include <Wire.h>
#include <Adafruit_PWMServoDriver.h>
#include <math.h>

Adafruit_PWMServoDriver pwm(0x40);

const int SERVOMIN = 120;
const int SERVOMAX = 620;

// Leg servo pairs, in this order:
// 0 = front right, 1 = back left, 2 = front left, 3 = back right
const int LEG_A_CH[4] = {0, 3, 6, 9};
const int LEG_B_CH[4] = {1, 4, 7, 10};

// Right-side legs use the positive direction, left-side legs are mirrored.
const float LEG_DIRECTION[4] = {1.0f, -1.0f, -1.0f, 1.0f};

// Linkage dimensions (mm)
const float D  = 27.5f; 
const float L1 = 80.966f;
const float L2 = 110.969f;

// Motion settings
const int LOOP_DELAY_MS = 15;
const float PAW_Y_RANGE_SCALE = 0.22f;
const float PAW_Y_LOWEST = -184.0f;
const float PAW_X_RANGE_SCALE = 1.7f;
const float CROUCH_HEIGHT = -210.0f;
const float PANCAKE_SIDE_OFFSET_MM = 55.0f;
const float IDLE_Y_CENTER_MM = -170.0f;
const float IDLE_Y_AMPLITUDE_MM = 22.0f;
const float JUMP_Y_START_MM = -185.0f;
const float JUMP_Y_LAUNCH_MM = -210.0f;
const float JUMP_Y_AIR_MM = -130.0f;
const float JUMP_Y_RECOVER_MM = -170.0f;

// Servo ranges for channels 0–11
const int servoMin[12] = {63, 0, 13, 60, 0, 60, 20, 73, 80, 15, 63, 40};
const int servoMax[12] = {120, 60, 90, 120, 60, 120, 70, 110, 120, 63, 120, 80};

// Default servo positions
const int servoDefault[12] = {85, 40, 63, 90, 40, 82, 50, 86, 97, 45, 90, 63};

// Shoulder channels: 2 = 63°, 5 = 82°, 8 = 97°, 11 = 63°
const int SHOULDER_CH[4] = {2, 5, 8, 11};

// Paw path coordinates in millimeters
const float pawPositions[][2] = 
{
  {-8, -175}, {-7, -177}, {-6, -179}, {-5, -180},
  {-4, -181}, {-3, -182}, {-2, -183}, {-1, -183},
  { 0, -184}, { 1, -183}, { 2, -183}, { 3, -182},
  { 4, -181}, { 5, -180}, { 6, -179}, { 7, -177},
  { 8, -175}, { 7, -165}, { 6, -163}, { 5, -162}, 
  { 4, -161}, { 3, -160}, { 2, -159}, { 1, -159}, 
  { 0, -158}, {-1, -159}, {-2, -159}, {-3, -160}, 
  {-4, -161}, {-5, -162}, {-6, -163}, {-7, -165}, 
  {-8, -168}
};

const int NUM_POINTS = sizeof(pawPositions) / sizeof(pawPositions[0]);
const int LEG_PHASE_OFFSET = NUM_POINTS / 2;

float referenceA[4];
float referenceB[4];
bool referencesSet = false;

bool stopped = false;
bool isCrouched = false;
int pointIndex = 0;
int gaitDirection = 1; // 1 for forward, -1 for backward
int gaitMode = 0;      // 0 = Straight, 1 = Turn Right, 2 = Turn Left, 3 = Pancake, 4 = Idle, 5 = Jump

float adjustPawX(float x) 
{
  return x * PAW_X_RANGE_SCALE;
}

float adjustPawY(float y) 
{
  return PAW_Y_LOWEST + (y - PAW_Y_LOWEST) * PAW_Y_RANGE_SCALE;
}

void setServo(int channel, float angle) 
{
  angle = constrain(angle, (float)servoMin[channel], (float)servoMax[channel]);

  int pulse = SERVOMIN + (int)((angle / 180.0f) * (SERVOMAX - SERVOMIN));

  pwm.setPWM(channel, 0, pulse);
}

// Turn off all motor PWM outputs completely
void disableAllServos() 
{
  for (int i = 0; i < 12; i++) 
  {
    pwm.setPWM(i, 0, 4096);
  }
}

void lockShoulders() 
{
  setServo(2, 63);
  setServo(5, 82);
  setServo(8, 97);
  setServo(11, 63);
}

float wrap180(float angle) 
{
  while (angle > 180.0f) angle -= 360.0f;
  while (angle < -180.0f) angle += 360.0f;
  return angle;
}

void checkSerial() 
{
  while (Serial.available() > 0) 
  {
    char command = Serial.read();

    if (command == 's' || command == 'S') 
    {
      stopped = true;
      isCrouched = false;
      disableAllServos();
      Serial.println("STOPPED");
    }
    else if (command == 'c' || command == 'C') 
    {
      stopped = true;
      isCrouched = true;
      Serial.println("CROUCHED");
    }
    else if (command == 'f' || command == 'F') 
    {
      stopped = false;
      isCrouched = false;
      gaitMode = 0; // Straight mode
      gaitDirection = 1;
      Serial.println("FORWARD");
    }
    else if (command == 'b' || command == 'B') 
    {
      stopped = false;
      isCrouched = false;
      gaitMode = 0; // Straight mode
      gaitDirection = -1;
      Serial.println("BACKWARD");
    }
    else if (command == 'r' || command == 'R') 
    {
      stopped = false;
      isCrouched = false;
      gaitMode = 1; // Turn Right mode
      gaitDirection = 1;
      Serial.println("RIGHT TURN");
    }
    else if (command == 'l' || command == 'L') 
    {
      stopped = false;
      isCrouched = false;
      gaitMode = 2; // Turn Left mode
      gaitDirection = 1;
      Serial.println("LEFT TURN");
    }
    else if (command == 'p' || command == 'P') 
    {
      stopped = false;
      isCrouched = false;
      gaitMode = 3; // Pancake mode
      gaitDirection = 1;
      Serial.println("PANCAKE MODE");
    }
    else if (command == 'i' || command == 'I') 
    {
      stopped = false;
      isCrouched = false;
      gaitMode = 4; // Idle mode
      gaitDirection = 1;
      Serial.println("IDLE MODE");
    }
    else if (command == 'j' || command == 'J') 
    {
      stopped = false;
      isCrouched = false;
      gaitMode = 5; // Jump mode
      gaitDirection = 1;
      Serial.println("JUMP MODE");
    }
  }
}

void controlledDelay(int duration) 
{
  unsigned long start = millis();

  while (millis() - start < (unsigned long)duration) 
  {
    checkSerial();

    if (stopped) 
    {
      return;
    }

    delay(1);
  }
}

bool calculateUpperAngle( float x, float y, float baseX, float &angle) 
{
  float dx = x - baseX;
  float r = sqrt(dx * dx + y * y);

  if (r > L1 + L2 || r < fabs(L1 - L2) || r < 0.001f) 
  {
    return false;
  }

  float a = (L1 * L1 - L2 * L2 + r * r) / (2.0f * r);

  float hSquared = L1 * L1 - a * a;

  if (hSquared < -0.01f) 
  {
    return false;
  }

  if (hSquared < 0.0f) 
  {
    hSquared = 0.0f;
  }

  float h = sqrt(hSquared);
  float ux = dx / r;
  float uy = y / r;

  float ex1 = baseX + a * ux - h * uy;
  float ey1 = a * uy + h * ux;

  float ex2 = baseX + a * ux + h * uy;
  float ey2 = a * uy - h * ux;

  float ex;
  float ey;

  if (ey1 >= ey2) 
  {
    ex = ex1;
    ey = ey1;
  } 
  else 
  {
    ex = ex2;
    ey = ey2;
  }

  angle = atan2(ey, ex - baseX) * 180.0f / PI;
  return true;
}

bool calculatePawAngles(float x, float y, float &angleA, float &angleB) 
{
  x = adjustPawX(x);
  y = adjustPawY(y);

  if (!calculateUpperAngle(x, y, -D / 2.0f, angleA)) 
  {
    return false;
  }

  if (!calculateUpperAngle(x, y, D / 2.0f, angleB)) 
  {
    return false;
  }

  return true;
}

bool moveAllLegs(const int legPoint[4], bool forceCrouch = false) 
{
  float angleA[4];
  float angleB[4];

  for (int leg = 0; leg < 4; leg++) 
  {
    float targetX = 0.0f;
    float targetY = 0.0f;

    if (gaitMode == 3) 
    {
      float sideSign = (leg == 0 || leg == 3) ? 1.0f : -1.0f;
      targetX = sideSign * PANCAKE_SIDE_OFFSET_MM;
      targetY = -170.0f;
    }
    else if (gaitMode == 4) 
    {
      float phase = (float)millis() / 1000.0f + leg * 0.8f;
      targetX = 0.0f;
      targetY = IDLE_Y_CENTER_MM + sin(phase * 2.0f) * IDLE_Y_AMPLITUDE_MM;
    }
    else if (gaitMode == 5) 
    {
      float phase = (float)(millis() % 2200UL) / 2200.0f;
      targetX = 0.0f;

      if (phase < 0.25f) 
      {
        targetY = JUMP_Y_START_MM + (JUMP_Y_LAUNCH_MM - JUMP_Y_START_MM) * (phase / 0.25f);
      }
      else if (phase < 0.65f) 
      {
        float local = (phase - 0.25f) / (0.40f);
        targetY = JUMP_Y_LAUNCH_MM + (JUMP_Y_AIR_MM - JUMP_Y_LAUNCH_MM) * local;
      }
      else 
      {
        float local = (phase - 0.65f) / 0.35f;
        targetY = JUMP_Y_AIR_MM + (JUMP_Y_RECOVER_MM - JUMP_Y_AIR_MM) * local;
      }
    }
    else 
    {
      int p = legPoint[leg];
      targetX = pawPositions[p][0];
      targetY = pawPositions[p][1];
    }

    if (forceCrouch && (leg == 1 || leg == 3)) 
    {
      targetX = 0.0f; 
      targetY = CROUCH_HEIGHT; 
    }

    if (!calculatePawAngles(targetX, targetY, angleA[leg], angleB[leg])) {
      Serial.print("Leg linkage unreachable at leg ");
      Serial.println(leg);
      return false;
    }
  }

  if (!referencesSet) 
  {
    for (int leg = 0; leg < 4; leg++) 
    {
      referenceA[leg] = angleA[leg];
      referenceB[leg] = angleB[leg];
    }
    referencesSet = true;
  }

  for (int leg = 0; leg < 4; leg++) 
  {
    int channelA = LEG_A_CH[leg];
    int channelB = LEG_B_CH[leg];

    float deltaA = LEG_DIRECTION[leg] * wrap180(angleA[leg] - referenceA[leg]);
    float deltaB = LEG_DIRECTION[leg] * wrap180(angleB[leg] - referenceB[leg]);

    setServo(channelA, servoDefault[channelA] + deltaA);
    setServo(channelB, servoDefault[channelB] + deltaB);
  }

  lockShoulders();
  return true;
}

void setup() 
{
  Serial.begin(115200);
  Wire.begin();

  pwm.begin();
  pwm.setPWMFreq(50);
  delay(300);

  for (int leg = 0; leg < 4; leg++) 
  {
    setServo(LEG_A_CH[leg], servoDefault[LEG_A_CH[leg]]);
    setServo(LEG_B_CH[leg], servoDefault[LEG_B_CH[leg]]);
  }

  lockShoulders();

  Serial.println("BARQ V5 four-leg gait ready");
  Serial.println("Commands: f=Forward, b=Backward, r/t=Turn Right, l=Turn Left, p=Pancake, i=Idle, j=Jump, c=Lower/Crouch, s=Stop & Disable");
}

void loop() 
{
  checkSerial();

  if (stopped) 
  {
    if (isCrouched) 
    {
      int phasePoint = (pointIndex + LEG_PHASE_OFFSET) % NUM_POINTS;
      int inversePoint = (NUM_POINTS - pointIndex) % NUM_POINTS;
      int legPoint[4] = { (NUM_POINTS - pointIndex) % NUM_POINTS, pointIndex, (LEG_PHASE_OFFSET - pointIndex + NUM_POINTS) % NUM_POINTS, phasePoint };
      moveAllLegs(legPoint, true);
    }
    delay(15);
    return;
  }

  lockShoulders();

  int phasePoint = (pointIndex + LEG_PHASE_OFFSET) % NUM_POINTS;
  int inversePoint = (NUM_POINTS - pointIndex) % NUM_POINTS;

  int legPoint[4];

  if (gaitMode == 1) 
  {
    // TURN RIGHT MODE (Left side forward, Right side backward)
    legPoint[0] = inversePoint;                               // Front Right (Backward)
    legPoint[1] = pointIndex;                                 // Back Left (Forward)
    legPoint[2] = (LEG_PHASE_OFFSET - pointIndex + NUM_POINTS) % NUM_POINTS; // Front Left (Forward)
    legPoint[3] = inversePoint;                               // Back Right (Backward)
  }
  else if (gaitMode == 2) 
  {
    // TURN LEFT MODE (Right side forward, Left side backward)
    legPoint[0] = pointIndex;                                 // Front Right (Forward)
    legPoint[1] = inversePoint;                               // Back Left (Backward)
    legPoint[2] = inversePoint;                               // Front Left (Backward)
    legPoint[3] = pointIndex;                                 // Back Right (Forward)
  }
  else if (gaitMode == 3 || gaitMode == 4 || gaitMode == 5) 
  {
    legPoint[0] = 0;
    legPoint[1] = 0;
    legPoint[2] = 0;
    legPoint[3] = 0;
  }
  else 
  {
    // STRAIGHT MODE
    legPoint[0] = (NUM_POINTS - pointIndex) % NUM_POINTS;     // Front Right
    legPoint[1] = pointIndex;                                 // Back Left
    legPoint[2] = (LEG_PHASE_OFFSET - pointIndex + NUM_POINTS) % NUM_POINTS; // Front Left
    legPoint[3] = phasePoint;                                 // Back Right
  }

  if (!moveAllLegs(legPoint, false)) 
  {
    stopped = true;
    disableAllServos();
    Serial.println("Gait stopped: unreachable point. Motors disabled.");
    return;
  }

  pointIndex += gaitDirection;

  if (pointIndex >= NUM_POINTS) 
  {
    pointIndex = 0;
  } 
  else if (pointIndex < 0) 
  {
    pointIndex = NUM_POINTS - 1;
  }

  controlledDelay(LOOP_DELAY_MS);
}
